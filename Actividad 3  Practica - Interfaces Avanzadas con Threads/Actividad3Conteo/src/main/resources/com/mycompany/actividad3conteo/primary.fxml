<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER"
      spacing="18.0"
      prefWidth="420.0"
      prefHeight="520.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mycompany.actividad3conteo.PrimaryController">

    <padding>
        <Insets top="25.0"
                right="30.0"
                bottom="25.0"
                left="30.0"/>
    </padding>

    <Label text="Contar número de clics"
           style="-fx-font-size: 16px;"/>

    <TextField fx:id="txtClicks"
               editable="false"
               alignment="CENTER"
               prefWidth="340.0"
               promptText="0"/>

    <Button text="¡Contar!"
            onAction="#contarClick"
            prefWidth="110.0"
            prefHeight="38.0"/>

    <Label text="Esperar 10 segundos"
           style="-fx-font-size: 16px;"/>

    <ProgressBar fx:id="progressBar"
                 progress="0.0"
                 prefWidth="340.0"
                 maxWidth="340.0"
                 prefHeight="25.0"/>

    <Button fx:id="btnEsperar"
            text="¡Esperar!"
            onAction="#esperar"
            prefWidth="110.0"
            prefHeight="38.0"/>

</VBox>
